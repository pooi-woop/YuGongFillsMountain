<?xml version="1.0" encoding="utf-8"?>
<!--
  愚公填山 - 建筑定义
  ===========================================

  本文件定义了"厚岩顶建造标记"建筑。
  - 玩家在游戏内通过建筑菜单放置此标记
  - 殖民者会用"挖掘"(Mining) 工作类型去完成此建筑的建造框架（Frame）
  - 建造完成的瞬间，C# ThingComp (CompPlaceThickRoof) 会把这一格的屋顶设为"厚岩顶"
  - 然后标记建筑自动销毁，留下厚岩顶
-->
<Defs>

  <!--
    厚岩顶建造标记
    - ParentName="BuildingBase": 继承原版基础建筑父类（提供了 category=Building 等基础属性）
    - size=(1,1): 占地 1x1 格
    - passability=Standable: 殖民者可站在格子上（不会阻挡通行）
    - fillPercent=0.05: 几乎不阻挡视野
    - terrainAffordanceNeeded=Light: 可在轻承载地形（多数地面）建造
  -->
  <ThingDef ParentName="BuildingBase">
    <!-- defName 唯一标识。前缀 YGFM_ = Yu Gong Fills Mountain -->
    <defName>YGFM_ThickRoofBuilder</defName>
    <label>厚岩顶建造标记</label>
    <description>殖民者会以"挖掘"工作类型花费大量工作量，将这一格的屋顶变为厚岩顶。完成后标记自动消失。</description>

    <!-- 占地尺寸 -->
    <size>(1,1)</size>

    <!-- 建筑菜单分类。可选: Production, Furniture, Structure, Power, Temperature, Security, Recreation, Misc -->
    <!-- 此处放在 Structure (结构) 分类下，与原版墙体/屋顶建造菜单同类 -->
    <designationCategory>Structure</designationCategory>

    <!-- 拖拽框选：使用 Fill2D 样式，支持 FilledRectangle（矩形框选）与 FilledOval（椭圆框选） -->
    <drawStyleCategory>Fill2D</drawStyleCategory>

    <statBases>
      <MaxHitPoints>50</MaxHitPoints>          <!-- 耐久度（标记很脆弱） -->
      <!--
        WorkToBuild: 建造工作量。
        RimWorld 中 1 个游戏日 ≈ 60000 tick，普通工人每 tick 工作效率约 0.4~0.6 工作量（取决于技能）。
        假设普通工人约 12000 工作量/游戏日（含工作间歇），2 个游戏日 ≈ 24000 工作量。
        实际有效工作量 = 此值 × Mod 设置中的"工作量倍率"(默认 1.0)
      -->
      <WorkToBuild>24000</WorkToBuild>
      <Flammability>0</Flammability>            <!-- 不可燃 -->
      <Beauty>-3</Beauty>                       <!-- 略影响美观 -->
      <Mass>1</Mass>
    </statBases>

    <!-- 材料成本。设为空表示无需材料，只需工作量。
         如果希望殖民者需要运送材料才能建造，可在此加入 <Steel>50</Steel> 等。 -->
    <costList>
    </costList>

    <!-- 通过性: Impassable / PassThroughOnly / Standable -->
    <passability>Standable</passability>
    <!-- 贴图填充率 (0-1)，1 表示完全占满格子，<1 表示建筑不占满格子 -->
    <fillPercent>0.05</fillPercent>

    <!-- 地形承载要求: Light / Medium / Heavy。Light 可在大多数地面建造 -->
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>

    <!-- 是否可旋转。这里 1x1 不需要旋转 -->
    <rotatable>false</rotatable>

    <!-- 贴图：使用本模组自带的占位贴图（标记建筑完成后立即销毁，仅建造期间显示）。 -->
    <graphicData>
      <texPath>Buildings/ThickRoofBuilder</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(0.5,0.5)</drawSize>
    </graphicData>

    <!-- 1.6 起 blueprintGraphicData 字段已移除，蓝图外观自动由 graphicData 派生，不再单独声明 -->

    <!-- uiIconPath: 在建筑菜单中显示的图标 -->
    <uiIconPath>Buildings/ThickRoofBuilder</uiIconPath>

    <!--
      ThingComp: 自定义组件
      - Class 必须指向 C# 中的 CompProperties 子类（含命名空间）
      - destroySelfOnComplete: 完成后是否销毁标记本身（true = 销毁，只留下厚岩顶）
    -->
    <comps>
      <li Class="YGFM.CompProperties_PlaceThickRoof">
        <destroySelfOnComplete>true</destroySelfOnComplete>
      </li>
    </comps>

    <!-- 研究前置。需要先研究 YGFM_MountainFilling 才能建造此标记 -->
    <researchPrerequisites>
      <li>YGFM_MountainFilling</li>
    </researchPrerequisites>
  </ThingDef>

</Defs>
